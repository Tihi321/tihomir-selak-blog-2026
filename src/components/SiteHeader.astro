---
import { PERSONAL_SITE_URL } from "../site";
import SiteControls from "./SiteControls.astro";
import SynapseMark from "./SynapseMark.astro";

const path = Astro.url.pathname;
const sections = [
  { label: "Latest", href: "/", current: path === "/" },
  {
    label: "Writing",
    href: "/writing/",
    current: path.startsWith("/writing") || path.startsWith("/draft-preview"),
  },
  { label: "Topics", href: "/topics/", current: path.startsWith("/topics") },
  { label: "About", href: "/about/", current: path.startsWith("/about") },
  { label: "RSS", href: "/rss.xml", current: false },
];
---

<header class="site-header wrap">
  <a
    class="site-header__wordmark"
    href={PERSONAL_SITE_URL}
    aria-label="Tihomir Selak home"
  >
    <SynapseMark />
    Tihomir Selak
  </a>
  <nav class="site-header__nav" aria-label="Main navigation">
    <a href={`${PERSONAL_SITE_URL}/#work`}>Work</a>
    <a href={`${PERSONAL_SITE_URL}/#approach`}>Approach</a>
    <a href={`${PERSONAL_SITE_URL}/#experience`}>Experience</a>
    <a href={`${PERSONAL_SITE_URL}/#contact`}>Contact</a>
    <a href="/" aria-current="page">Blog</a>
  </nav>
  <SiteControls />
</header>
<nav class="blog-sections wrap" aria-label="Blog sections">
  {
    sections.map((section) => (
      <a
        href={section.href}
        aria-current={section.current ? "page" : undefined}
      >
        {section.label}
      </a>
    ))
  }
</nav>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
    border-bottom: var(--border-hair);
  }

  .site-header__wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-paper-bright);
    font-weight: 600;
    font-stretch: 88%;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-header__wordmark:hover {
    text-decoration: underline;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: var(--lh--2);
  }

  /* The current section is paper-bright with no underline, not phosphor. */
  .site-header__nav a[aria-current="page"],
  .blog-sections a[aria-current="page"] {
    color: var(--c-paper-bright);
    text-decoration: none;
  }

  /* Narrow: wordmark and controls share the first row, the nav wraps below. */
  .site-header :global(.site-controls) {
    order: 1;
    margin-left: auto;
  }

  .site-header__nav {
    order: 2;
    flex-basis: 100%;
  }

  .blog-sections {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--border-hair);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: var(--lh--2);
  }

  @media (min-width: 720px) {
    .site-header__nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
    }

    .site-header :global(.site-controls) {
      order: 0;
      margin-left: 0;
    }
  }
</style>
