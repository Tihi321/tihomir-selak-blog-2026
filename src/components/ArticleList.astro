---
import { toWritingEntry } from "../site";
import WritingList from "./WritingList.astro";

interface Props {
  articles: any[];
  draft?: boolean;
  label?: string;
}

const { articles, draft = false, label } = Astro.props;
const entries = articles.map((article) => toWritingEntry(article, draft));
---

<WritingList entries={entries} label={label} />
