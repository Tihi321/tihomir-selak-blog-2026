---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleNavigation from "../../components/ArticleNavigation.astro";
import { articleSlug, isPublished, sortNewest } from "../../site";
export async function getStaticPaths() {
  const articles = await getCollection(
    "writing",
    (article) =>
      isPublished(article) ||
      (import.meta.env.DEV &&
        article.data.status === "published" &&
        article.id.startsWith("__playwright-fixture")),
  );
  return articles.map((article) => ({
    params: { slug: article.id.replace(/\.(md|mdx)$/, "") },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const published = sortNewest(await getCollection("writing", isPublished));
const fixtureArticle =
  import.meta.env.DEV && article.id.startsWith("__playwright-fixture");
const navigationArticles = sortNewest(
  fixtureArticle
    ? [
        ...published,
        ...(await getCollection(
          "writing",
          (entry) =>
            entry.data.status === "published" &&
            entry.id.startsWith("__playwright-fixture"),
        )),
      ]
    : published,
);
const currentIndex = navigationArticles.findIndex(
  (entry) => entry.id === article.id,
);
const related = published
  .filter(
    (entry) =>
      entry.id !== article.id &&
      entry.data.topics.some((topic) => article.data.topics.includes(topic)),
  )
  .slice(0, 2);
const link = (entry: (typeof navigationArticles)[number]) => ({
  href: `/writing/${articleSlug(entry)}/`,
  title: entry.data.title,
});
const rows = [
  currentIndex > 0 && {
    label: "Newer",
    links: [link(navigationArticles[currentIndex - 1])],
  },
  currentIndex < navigationArticles.length - 1 && {
    label: "Older",
    links: [link(navigationArticles[currentIndex + 1])],
  },
  related.length > 0 && { label: "Related", links: related.map(link) },
].filter((row) => row !== false);
---

<ArticleLayout article={article} Content={Content}>
  <ArticleNavigation rows={rows} />
</ArticleLayout>
