---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import PageIntro from "../../components/PageIntro.astro";
import { isPublished, sortNewest, topicLabel } from "../../site";
const writing = sortNewest(await getCollection("writing", isPublished));
export async function getStaticPaths() {
  const published = await getCollection("writing", isPublished);
  const topics = [
    ...new Set(published.flatMap((article) => article.data.topics)),
  ];
  return topics.map((topic) => ({ params: { topic }, props: { topic } }));
}
const { topic } = Astro.props;
const articles = writing.filter((article) =>
  article.data.topics.includes(topic),
);
---

<BaseLayout
  title={`Topic: ${topicLabel(topic)}`}
  description={`Published writing filed under ${topicLabel(topic)}.`}
>
  <PageIntro title={topicLabel(topic)} lead="Writing filed under this topic." />
  <section class="wrap archive-list" aria-label="Articles in this topic">
    <ArticleList
      articles={articles}
      label={`Writing on ${topicLabel(topic)}`}
    />
  </section>
</BaseLayout>

<style>
  .archive-list {
    padding-bottom: var(--space-8);
  }
</style>
