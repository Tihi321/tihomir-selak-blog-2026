---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import TagList from "../components/TagList.astro";
import { isPublished, sortNewest, SITE_DESCRIPTION, topicLabel } from "../site";
const writing = sortNewest(await getCollection("writing", isPublished));
const topics = [
  ...new Set(writing.flatMap((article) => article.data.topics)),
].sort();
const latest = writing.slice(0, 1);
const selected = writing
  .filter((article) => article.data.featured && article.id !== latest[0]?.id)
  .slice(0, 4);
const themes = [
  {
    title: "Software in practice",
    text: "Clear notes on the decisions, trade-offs, and small details that shape useful software.",
  },
  {
    title: "Leading delivery",
    text: "Thoughts on helping teams make progress with care, shared context, and room to learn.",
  },
  {
    title: "Useful experiments",
    text: "Curiosity is welcome; claims should stay close to what experience and evidence can support.",
  },
];
---

<BaseLayout description={SITE_DESCRIPTION}>
  <PageIntro
    title="Notes from the work."
    lead="Field notes on software, leadership, practical AI, and experiments that became useful."
  />
  <div class="wrap">
    <Section id="latest" headingId="latest-heading" label="Latest">
      {
        latest.length ? (
          <ArticleList articles={latest} label="Latest writing" />
        ) : (
          <p>No articles have been published yet.</p>
        )
      }
    </Section>
    {
      writing.length === 0 && (
        <Section
          id="editorial"
          headingId="editorial-heading"
          label="What belongs here"
        >
          <dl class="themes">
            {themes.map((theme) => (
              <div class="themes__row">
                <dt>{theme.title}</dt>
                <dd>{theme.text}</dd>
              </div>
            ))}
          </dl>
          <p>
            <a href="/about/">A little more about this site and its approach</a>
          </p>
        </Section>
      )
    }
    {
      selected.length > 0 && (
        <Section id="selected" headingId="selected-heading" label="Selected">
          <ArticleList articles={selected} label="Selected writing" />
        </Section>
      )
    }
    {
      topics.length > 0 && (
        <Section id="topics" headingId="topics-heading" label="Topics">
          <TagList
            label="Topics"
            tags={topics.map((topic) => ({
              label: topicLabel(topic),
              href: `/topics/${topic}/`,
            }))}
          />
        </Section>
      )
    }
  </div>
</BaseLayout>

<style>
  .themes {
    border-top: var(--border-hair);
    max-width: var(--measure);
  }

  .themes__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-bottom: var(--border-hair);
  }

  .themes dt {
    color: var(--c-paper-bright);
    font-weight: 500;
  }

  .themes dd {
    margin: 0;
  }

  @media (min-width: 720px) {
    .themes__row {
      grid-template-columns: 22ch minmax(0, 1fr);
      column-gap: var(--space-5);
    }
  }
</style>
