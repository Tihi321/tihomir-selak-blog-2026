---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="not-found wrap">
    <h1>Not found.</h1>
    <p class="not-found__text">
      This address does not point to a published page. Browse the <a
        href="/writing/">writing archive</a
      > or return to the <a href="/">latest notes</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9);
    min-height: 50vh;
    align-content: start;
  }

  .not-found__text {
    max-width: var(--measure);
  }
</style>
