---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { PERSONAL_SITE_URL } from "../site";
---

<BaseLayout
  title="About"
  description="About this publication and its editorial approach."
>
  <PageIntro
    title="About these notes"
    lead="A working record, edited with care."
  />
  <section class="about wrap grid-12" aria-label="About this publication">
    <div class="about__copy">
      <p>
        This is a place for practical notes on software engineering, technical
        leadership, useful tools, and selected creative experiments. The aim is
        to explain what I tried, what shaped the decisions, and what I learned,
        with room for limits and uncertainty.
      </p>
      <p>
        Older pieces are dated honestly when revised. Drafts stay out of the
        published site until they are ready for editorial review. Work related
        to employers or customers appears only when it can be discussed openly.
      </p>
      <p>
        I’m Tihomir, a software engineer and development team lead. <a
          href={PERSONAL_SITE_URL}>My personal site</a
        > has a shorter introduction and links to my work.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-bottom: var(--space-8);
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
    grid-column: 1 / -1;
    max-width: var(--measure);
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .about__copy {
      grid-column: 3 / span 8;
    }
  }
</style>
