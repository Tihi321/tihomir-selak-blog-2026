---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleNavigation from "../../components/ArticleNavigation.astro";
import { articleSlug, sortNewest } from "../../site";
export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const drafts = sortNewest(
    await getCollection("writing", ({ data }) => data.status === "draft"),
  );
  return drafts.map((article) => ({
    params: { slug: article.id.replace(/\.(md|mdx)$/, "") },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const drafts = sortNewest(
  await getCollection("writing", ({ data }) => data.status === "draft"),
);
const currentIndex = drafts.findIndex((entry) => entry.id === article.id);
const link = (entry: (typeof drafts)[number]) => ({
  href: `/draft-preview/${articleSlug(entry)}/`,
  title: entry.data.title,
});
const rows = [
  currentIndex > 0 && {
    label: "Newer draft",
    links: [link(drafts[currentIndex - 1])],
  },
  currentIndex < drafts.length - 1 && {
    label: "Older draft",
    links: [link(drafts[currentIndex + 1])],
  },
].filter((row) => row !== false);
---

<ArticleLayout article={article} Content={Content} draft>
  <ArticleNavigation rows={rows} />
</ArticleLayout>
