---
import "../styles/global.css";
import { Font } from "astro:assets";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../site";
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
  type?: "website" | "article";
}
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonical,
  socialImage = `${SITE_URL}/social-card.png`,
  type = "website",
} = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | Tihomir Selak`;
const url = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline src="/scripts/theme-init.js"></script>
    <meta
      name="theme-color"
      content="#0A1020"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#EEF2F8"
      media="(prefers-color-scheme: light)"
    />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Tihomir Selak, field notes"
      href="/rss.xml"
    />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-martian-mono" preload />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Tihomir Selak, field notes" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
